# ---- Client (Vite needs the VITE_ prefix; safe to expose) ----
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Public VAPID key for push (the one generated for you — or run your own):
VITE_VAPID_PUBLIC_KEY=BIhmy_IclZhhxtW81sg0_NuDSbQ3yOl01t17m-qcBxaKgUdj7j84qgNnPXgXK2AfuLAAOixGGzCuDxgBlfbgJf4

# ---- Server only (set in Vercel; NEVER commit real values) ----
GEMINI_API_KEY=your-gemini-key
# Push sender:
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=BIhmy_IclZhhxtW81sg0_NuDSbQ3yOl01t17m-qcBxaKgUdj7j84qgNnPXgXK2AfuLAAOixGGzCuDxgBlfbgJf4
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
NOTIFY_SECRET=make-a-long-random-string
# Optional: hour (UTC) to send the daily reminder. 16 ≈ 18:00 Berlin in summer.
REMINDER_HOUR_UTC=16
