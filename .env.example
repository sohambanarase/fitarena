# ---- Client-side (safe to expose; the anon key is meant to be public, RLS protects data) ----
# In Vite, only vars prefixed with VITE_ are exposed to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server-side only (NEVER prefixed with VITE_, never reaches the browser) ----
# Used by /api/coach.js running on Vercel. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
