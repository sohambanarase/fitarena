# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# ---- Client. Ships in the browser bundle, which is fine. See SECURITY.md ----
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ---- Server only. Set these in Vercel, never here ----

# AI. Gemini is the primary; the other two are free fallbacks with no card needed.
# Gemini's free quota is per-project, so a rate limit hits every Gemini model at once.
# Adding either fallback gives the app a second provider on a separate key.
GEMINI_API_KEY=your-gemini-key           # aistudio.google.com/apikey
GROQ_API_KEY=                            # console.groq.com/keys  (text fallback)
OPENROUTER_API_KEY=                      # openrouter.ai/keys     (text + image backstop)

# Optional model pins. Leave blank unless you have a reason.
# GEMINI_MODEL=
# GROQ_MODEL=
# GROQ_VISION_MODEL=                     # set only if Groq ships a new vision model
# OPENROUTER_MODEL=                      # defaults to openrouter/free

# Push notifications
SUPABASE_URL=your-supabase-url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # bypasses RLS, keep secret
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com
NOTIFY_SECRET=make-a-long-random-string
REMINDER_HOUR_UTC=16                     # 16 UTC is about 18:00 Berlin in summer
